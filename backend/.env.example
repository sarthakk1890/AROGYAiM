NODE_ENV=development
PORT=5000

# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/mova?schema=public

# Used to build links in verification/reset emails; must be the frontend's origin
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins (no wildcard — cookies require an exact origin)
CORS_ORIGIN=http://localhost:5173

# Required in production — must be long, random secrets, never the defaults below
JWT_SECRET=super-secret-jwt-key
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super-secret-refresh-key
JWT_REFRESH_EXPIRES_IN=7d

REDIS_URL=redis://localhost:6379

EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@mova.com
